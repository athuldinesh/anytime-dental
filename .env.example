# Copy to your host's environment settings. Everything except PUBLIC_URL can also be set later in the dashboard.
PORT=9822
NODE_ENV=production
# Where the SQLite database lives. Point this at a persistent disk in production.
DATA_DIR=./server/data
# The address patients open from WhatsApp links (reschedule, survey, booking).
PUBLIC_URL=https://anytimedental.ae
# First admin account (only used when the database is empty).
ADMIN_EMAIL=admin@anytimedental.ae
ADMIN_PASSWORD=change-me-to-something-long
# Signs dashboard sessions. Any long random string.
APP_SECRET=
# Optional: Claude key for AI sorting of imported patient records (can be set in Settings instead).
ANTHROPIC_API_KEY=
